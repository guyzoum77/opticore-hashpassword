{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "module": "ESNext",
    "target": "es2024",
    "moduleResolution": "bundler",
    "declaration": true,
    "isolatedModules": true,
    "noEmit": false,
    "types": ["node"],
    "experimentalDecorators": true,
    "outDir": "./dist"
  },
  "include": ["./src"],
  "exclude": ["node_modules"]
}